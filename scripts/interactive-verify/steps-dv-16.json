    "width": 1440,
    "height": 900
  },
  {
    "op": "reload",
    "ms": 6000
  },
  {
    "op": "wait",
    "ms": 1500
  },
  {
    "op": "eval",
    "js": "(async()=>{const st=await (await fetch('http://127.0.0.1:8896/api/interactive/boards/board_default/state')).json();const c=st.state.cards[0];const el=document.querySelector('[data-card-id=\"'+c.id+'\"]');const r=el.getBoundingClientRect();return JSON.stringify({id:c.id,board:{x:c.x,y:c.y},screen:{x:Math.round(r.x),y:Math.round(r.y)}})})()"
  },
  {
    "op": "eval",
    "js": "(()=>{const vp=document.querySelector('.board-viewport')||document.querySelector(\"[data-im=\\\"board\\\"]\");const r=vp.getBoundingClientRect();const sx=r.left+700,sy=r.top+700;const down=new PointerEvent('pointerdown',{bubbles:true,clientX:sx,clientY:sy,pointerId:2,button:0,buttons:1});vp.dispatchEvent(down);for(let i=1;i<=6;i++){window.dispatchEvent(new PointerEvent('pointermove',{bubbles:true,clientX:sx-30*i,clientY:sy-20*i,pointerId:2,buttons:1}))}window.dispatchEvent(new PointerEvent('pointerup',{bubbles:true,clientX:sx-180,clientY:sy-120,pointerId:2}));return 'panned'})()"
  },
  {
    "op": "wait",
    "ms": 600
  },
  {
    "op": "eval",
    "js": "(async()=>{const st=await (await fetch('http://127.0.0.1:8896/api/interactive/boards/board_default/state')).json();const c=st.state.cards[0];const el=document.querySelector('[data-card-id=\"'+c.id+'\"]');const r=el.getBoundingClientRect();return JSON.stringify({boardUnchanged:{x:c.x,y:c.y},screenAfter:{x:Math.round(r.x),y:Math.round(r.y)},scroll:{left:Math.round((document.querySelector('.board-viewport')||{scrollLeft:0}).scrollLeft),top:Math.round((document.querySelector('.board-viewport')||{scrollTop:0}).scrollTop)}})})()"
  },
