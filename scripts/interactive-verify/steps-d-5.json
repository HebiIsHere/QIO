  {
    "op": "eval",
    "js": "(async()=>{const boxes=[...document.querySelectorAll('[data-im=\"batch-item\"] input[type=checkbox]')];const fire=el=>{el.checked=!el.checked;el.dispatchEvent(new Event('change',{bubbles:true}))};fire(boxes[0]);await new Promise(r=>setTimeout(r,120));fire(boxes[2]);await new Promise(r=>setTimeout(r,200));return JSON.stringify({checked:boxes.map(b=>b.checked),approve:document.querySelector('[data-im=\"batch-approve\"]').textContent.trim(),reject:document.querySelector('[data-im=\"batch-reject\"]').textContent.trim(),summary:(document.querySelector('.summary')||{}).textContent})})()"
