[
  {
    "op": "navigate",
    "url": "http://127.0.0.1:5431/#/interactive",
    "ms": 7000
  },
  {
    "op": "viewport",
    "width": 1440,
    "height": 900
  },
  {
    "op": "wait",
    "ms": 1500
  },
  {
    "op": "eval",
    "await": true,
    "js": "(async()=>{const B='http://127.0.0.1:8931';const r=await (await fetch(B+'/api/interactive/boards/board_default/intents')).json();const open=(r.intents||[]).filter(i=>['pending','needs_update','waiting_dependency','waiting_confirm','running','paused'].includes(i.status));for(const i of open){await fetch(B+'/api/interactive/intents/'+i.id+'/reject',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});}try{localStorage.removeItem('qio.interactive.intentBatches');}catch(e){}return JSON.stringify({mark:'pre', open:open.length});})()"
  },
  {
    "op": "eval",
    "js": "(function(){const b=document.querySelector('[data-im=\"demo-entry\"]');if(b)b.click();return 'opened';})()"
  },
  {
    "op": "wait",
    "ms": 700
  },
  {
    "op": "eval",
    "js": "(function(){const b=[...document.querySelectorAll('button')].find(x=>/演示|生成/.test(x.textContent)&&x.getBoundingClientRect().height>0&&x.closest('[data-im=\"demo-popover\"], .demo-popover, .im-demo-pop'));if(!b)return 'no-button';b.click();return 'clicked';})()"
  },
  {
    "op": "wait",
    "ms": 3000
  },
  {
    "op": "eval",
    "js": "JSON.stringify({mark:\"after\", record:String(localStorage.getItem('qio.interactive.intentBatches')||'').slice(0,400), ss:String(sessionStorage.getItem('qio.interactive.intentBatches')||'').slice(0,120), entry:!!document.querySelector('[data-im=\"batch-entry\"]'), text:(document.querySelector('[data-im=\"batch-entry\"]')||{}).textContent||''})"
  },
  {
    "op": "eval",
    "js": "location.reload(); 'reload'"
  },
  {
    "op": "wait",
    "ms": 6000
  },
  {
    "op": "eval",
    "js": "JSON.stringify({mark:\"reloaded\", record:String(localStorage.getItem('qio.interactive.intentBatches')||'').slice(0,400), entry:!!document.querySelector('[data-im=\"batch-entry\"]'), text:(document.querySelector('[data-im=\"batch-entry\"]')||{}).textContent||''})"
  },
  {
    "op": "screenshot",
    "name": "b9-debug3"
  }
]