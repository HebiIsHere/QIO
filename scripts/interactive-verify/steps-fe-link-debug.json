  {
    "op": "eval",
    "await": true,
    "js": "(async()=>{const raw=await (await fetch('http://127.0.0.1:8791/api/interactive/boards/board_default/state')).json();const j=raw.state||raw;const n=document.querySelector('.notice, [data-im=\"notice\"], .board-notice');return JSON.stringify({links:(j.links||[]).length, notice:n?n.textContent:''});})()"
  },
