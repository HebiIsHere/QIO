    "js": "(async()=>{const card=document.querySelector('[data-card-id=\"c_mux6xxyv13ny8\"]');if(!card)return 'no-card';card.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true}));await new Promise(r=>setTimeout(r,300));const bar=document.querySelector('[data-im=\"card-toolbar\"]');const btn=bar?[...bar.querySelectorAll('button')].find(b=>b.textContent.trim()==='编辑'):null;if(!btn)return JSON.stringify({toolbar:!!bar,buttons:bar?[...bar.querySelectorAll('button')].map(b=>b.textContent.trim()):null});btn.click();return 'editing'})()"
