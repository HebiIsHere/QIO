    "op": "eval",
    "js": "(()=>{const card=document.querySelector('[data-card-id]');const id=document.querySelector('[data-im=\"card-toolbar\"]')?document.querySelector('[data-im=\"card-toolbar\"]').getAttribute('data-card-id'):null;const pts=[...document.querySelectorAll(\"[data-im=\\\"connect-point\\\"]\")];const bar=document.querySelector(\"[data-im=\\\"card-toolbar\\\"]\");const g=(e)=>{if(!e)return null;const r=e.getBoundingClientRect();return {cls:e.className,top:Math.round(r.top),bottom:Math.round(r.bottom),left:Math.round(r.left),right:Math.round(r.right),w:Math.round(r.width),h:Math.round(r.height)}};const cardEl=id?document.querySelector('[data-card-id=\"'+id+'\"]'):null;const cr=cardEl?cardEl.getBoundingClientRect():null;const br=bar?bar.getBoundingClientRect():null;const prs=pts.map(p=>p.getBoundingClientRect());const overlap=(a,b)=>!(a.right<b.left||a.left>b.right||a.bottom<b.top||a.top>b.bottom);const covered=br?prs.filter(p=>overlap(p,br)).length:null;return JSON.stringify({toolbarCardId:id,card:cr?{top:Math.round(cr.top),bottom:Math.round(cr.bottom),left:Math.round(cr.left),right:Math.round(cr.right)}:null,toolbar:g(bar),points:pts.map(p=>g(p)),pointsCount:pts.length,pointsCoveredByToolbar:covered,pointsInsideCard:cr?prs.map(p=>p.left>=cr.left-1&&p.right<=cr.right+1&&p.top>=cr.top-1&&p.bottom<=cr.bottom+1):null})})()"
