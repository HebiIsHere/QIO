    "js": "(()=>{const panel=document.querySelector('[data-im=\"batch-list\"]');const bar=document.querySelector('[data-im=\"board-toolbar\"]');const submit=document.querySelector('[data-im=\"submit\"]');const pr=panel?panel.getBoundingClientRect():null;const br=bar?bar.getBoundingClientRect():null;const sr=submit?submit.getBoundingClientRect():null;const vis=el=>{if(!el)return null;const r=el.getBoundingClientRect();return r.width>0&&r.height>0&&r.top>=-1&&r.bottom<=window.innerHeight+1};return JSON.stringify({viewport:[window.innerWidth,window.innerHeight],panel:pr?{top:Math.round(pr.top),bottom:Math.round(pr.bottom)}:null,toolbar:br?{top:Math.round(br.top),bottom:Math.round(br.bottom)}:null,panelOverToolbar:pr&&br?pr.bottom>br.top:null,entryVisible:vis(document.querySelector('[data-im=\"batch-entry\"]')),submitVisible:vis(submit),submitRect:sr?{top:Math.round(sr.top),bottom:Math.round(sr.bottom)}:null,overflowX:document.documentElement.scrollWidth>window.innerWidth})})()"
