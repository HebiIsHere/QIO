    "js": "(async()=>{const e=document.querySelector('[data-im=\"batch-entry\"]');if(!e)return 'no-entry';e.click();await new Promise(r=>setTimeout(r,400));const boxes=[...document.querySelectorAll('[data-im=\"batch-item\"] input[type=checkbox]')];boxes[3].checked=true;boxes[3].dispatchEvent(new Event('change',{bubbles:true}));await new Promise(r=>setTimeout(r,250));document.querySelector('[data-im=\"batch-reject\"]').click();await new Promise(r=>setTimeout(r,1800));return JSON.stringify({entry:!!document.querySelector('[data-im=\"batch-entry\"]'),list:!!document.querySelector('[data-im=\"batch-list\"]'),notice:(document.querySelector('[data-im=\"batch-notice\"]')||{}).textContent})})()"
