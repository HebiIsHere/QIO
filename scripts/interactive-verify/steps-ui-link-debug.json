  },
  {
    "op": "eval",
    "js": "JSON.stringify([...document.querySelectorAll('[data-im=\"card\"]')].map(c=>{const r=c.getBoundingClientRect();return {id:c.getAttribute('data-card-id'),l:Math.round(r.left),t:Math.round(r.top),cx:Math.round(r.left+r.width/2),cy:Math.round(r.top+22)};}))"
  },
  {
    "op": "cdp",
    "method": "Input.dispatchMouseEvent",
    "params": {
      "type": "mousePressed",
      "x": 190,
      "y": 159,
      "button": "left",
      "clickCount": 1,
      "buttons": 1
    }
  },
  {
    "op": "wait",
