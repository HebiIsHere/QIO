  },
  {
    "op": "eval",
    "js": "JSON.stringify({mark:\"mid\", draft: !!document.querySelector('[data-im=\"link-draft\"]'), draftTarget:(document.querySelector('[data-im=\"link-draft\"]')||{}).getAttribute?document.querySelector('[data-im=\"link-draft\"]').getAttribute('data-target'):null})"
  },
