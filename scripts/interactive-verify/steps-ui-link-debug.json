    "js": "(async()=>{const raw=await (await fetch('http://127.0.0.1:8931/api/interactive/boards/board_default/state')).json();const j=raw.state||raw;return JSON.stringify({mark:\"links\", links:(j.links||[]).filter(l=>!l.deleted).length, notice:(document.querySelector('[data-im=\"notice\"], .notice, .banner')||{}).textContent||''});})()"
