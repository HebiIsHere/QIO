  },
  {
    "op": "cdp",
    "method": "Input.dispatchMouseEvent",
    "params": {
      "type": "mouseReleased",
      "x": 190,
      "y": 159,
      "button": "left",
      "clickCount": 0,
      "buttons": 0
    }
  },
  {
    "op": "wait",
    "ms": 700
  },
  {
    "op": "eval",
    "js": "JSON.stringify({mark:\"points\", points:[...document.querySelectorAll('[data-im=\"connect-point\"]')].map(p=>{const r=p.getBoundingClientRect();return {x:Math.round(r.left+r.width/2),y:Math.round(r.top+r.height/2)};}), toolbar:(function(){const t=document.querySelector('[data-im=\"card-toolbar\"]');if(!t)return null;const r=t.getBoundingClientRect();return {l:Math.round(r.left),t:Math.round(r.top),r:Math.round(r.right),b:Math.round(r.bottom)};})()})"
  },
  {
    "op": "cdp",
    "method": "Input.dispatchMouseEvent",
    "params": {
      "type": "mousePressed",
      "x": 190,
      "y": 174,
      "button": "left",
      "clickCount": 1,
      "buttons": 1
    }
  },
  {
    "op": "wait",
    "ms": 140
  },
  {
    "op": "eval",
    "js": "JSON.stringify({mark:\"afterdown\", draft: !!document.querySelector('[data-im=\"link-draft\"]')})"
