[
  {
    "op": "navigate",
    "url": "http://127.0.0.1:5431/#/interactive",
    "ms": 7000
  },
  {
    "op": "viewport",
    "width": 1440,
    "height": 900
  },
  {
    "op": "wait",
    "ms": 1500
  },
  {
    "op": "eval",
    "js": "(function(){const p=document.querySelector('[data-im=\"chat-panel\"]');if(!p){const b=document.querySelector('[data-im=\"chat-toggle\"]');if(b)b.click();}return 'open';})()"
  },
  {
    "op": "wait",
    "ms": 800
  },
  {
    "op": "eval",
    "js": "(function(){const t=document.querySelector('[data-im=\"chat-input\"] textarea, textarea[data-im=\"chat-input\"], [data-im=\"chat-input\"]');if(!t)return 'no-input';t.focus();t.value='中文草稿-调试-1';t.dispatchEvent(new Event('input',{bubbles:true}));return 'typed:'+t.tagName;})()"
  },
  {
    "op": "wait",
    "ms": 1500
  },
  {
    "op": "eval",
    "js": "JSON.stringify({keys:Object.keys(localStorage).filter(k=>k.indexOf('qio.draft')>=0), values:Object.keys(localStorage).filter(k=>k.indexOf('qio.draft')>=0).map(k=>k+'='+String(localStorage.getItem(k)).slice(0,80)), status:(document.querySelector('[data-im=\"chat-draft-status\"]')||{}).textContent||''})"
  },
  {
    "op": "eval",
    "js": "location.reload(); 'reload'"
  },
  {
    "op": "wait",
    "ms": 6000
  },
  {
    "op": "eval",
    "js": "(function(){const p=document.querySelector('[data-im=\"chat-panel\"]');if(!p){const b=document.querySelector('[data-im=\"chat-toggle\"]');if(b)b.click();}return 'reopen';})()"
  },
  {
    "op": "wait",
    "ms": 1200
  },
  {
    "op": "eval",
    "js": "(function(){const t=document.querySelector('[data-im=\"chat-input\"] textarea, textarea[data-im=\"chat-input\"], [data-im=\"chat-input\"]');return JSON.stringify({value:t?t.value:null, status:(document.querySelector('[data-im=\"chat-draft-status\"]')||{}).textContent||'', keys:Object.keys(localStorage).filter(k=>k.indexOf('qio.draft')>=0)});})()"
  },
  {
    "op": "screenshot",
    "name": "c-draft-debug"
  }
]