[
  {
    "op": "navigate",
    "url": "http://127.0.0.1:5431/#/interactive",
    "ms": 7000
  },
  {
    "op": "viewport",
    "width": 1440,
    "height": 900
  },
  {
    "op": "wait",
    "ms": 1500
  },
  {
    "op": "eval",
    "js": "(function(){window.__calls=[];if(!window.__of){window.__of=window.fetch.bind(window);}window.fetch=function(i,init){const u=String((i&&i.url)||i);const m=String((init&&init.method)||(i&&i.method)||'GET').toUpperCase();const p=window.__of(i,init);p.then(r=>window.__calls.push(m+' '+u+' -> '+r.status)).catch(e=>window.__calls.push(m+' '+u+' -> ERR '+e.message));return p;};return 'instrumented';})()"
  },
  {
    "op": "eval",
    "js": "(function(){const b=document.querySelector('[data-im=\"demo-entry\"]');if(b)b.click();return 'opened';})()"
  },
  {
    "op": "wait",
    "ms": 700
  },
  {
    "op": "eval",
    "js": "(function(){const b=[...document.querySelectorAll('button')].find(x=>/演示|生成/.test(x.textContent)&&x.getBoundingClientRect().height>0&&x.closest('[data-im=\"demo-popover\"], .demo-popover, .im-demo-pop'));if(!b)return 'no-button';b.click();return 'clicked:'+b.textContent.trim().slice(0,20);})()"
  },
  {
    "op": "wait",
    "ms": 3000
  },
  {
    "op": "eval",
    "js": "JSON.stringify({mark:\"diag\", calls:window.__calls, ls:Object.keys(localStorage).map(k=>k+'='+String(localStorage.getItem(k)).slice(0,60)), ss:Object.keys(sessionStorage).map(k=>k+'='+String(sessionStorage.getItem(k)).slice(0,60)), popover:(document.querySelector('[data-im=\"demo-popover\"]')||{}).textContent?document.querySelector('[data-im=\"demo-popover\"]').textContent.replace(/\\s+/g,' ').slice(0,200):null, entry:!!document.querySelector('[data-im=\"batch-entry\"]')})"
  },
  {
    "op": "screenshot",
    "name": "b9-debug2"
  }
]