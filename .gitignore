# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Node / frontend
node_modules/
dist/
frontend/src-tauri/target/

# Runtime data
*.db
*.db-wal
*.db-shm
archive/
logs/

# OS
Thumbs.db
.DS_Store
# Volar / vue-tsc 编辑器生成物（源码目录下勿提交 .js）
frontend/src/**/*.js

# 构建产物 / sidecar 二进制
backend/build-sidecar/
backend/dist-sidecar/
frontend/src-tauri/binaries/
frontend/src-tauri/gen/
frontend/e2e-shots/
# 内置模型资源（打包前由 scripts/models/fetch_model.py 生成；90MB 二进制不进仓库）
frontend/src-tauri/resources/

# 检查清单生成物
*.inspect.ndjson

# 运行期 pid 文件
scripts/.e2e-pids

# 本地/探索临时产物（不入库）
backend/.pytest_tmp/
vite.err.log
vite.log
spike_search/
# 测试临时残留：本机 %TEMP% 不可写时，tempfile 会退回到当前目录，
# 于是每次跑后端测试都会在 backend/ 下留一堆 tmp*/ 目录（还有 pytest 的
# 临时根目录与检索缓存）。它们是可再生的，不进库。
backend/tmp*/
backend/pytest-of-*/
backend/data-gym-cache/

# brainstorm 原型会话（可视化伴侣）
.superpowers/
backend/tmp*
.tmp/

# 本机构建/验收过程中的工作目录（可再生产物，不进库）：
#   .build-tmp   —— build_installer / build_sidecar 的构建临时目录
#                   （本机 %TEMP% 带拒绝访问的 ACL，所以默认放检出内）
#   .e2e-work    —— scripts/install_e2e.py 的安装目录、证据与 E2E 数据库
.build-tmp/
.e2e-work/
# 测试/构建脚本产生的报告产物（junit xml、_MEI 解包残留），不进库：
#   backend/qio-*.xml  —— 各 agent 跑 pytest --junitxml=qio-*.xml 留下的报告
backend/qio-*.xml
*.junit.xml
# Agent 验收/实验脚本的工作目录（可再生产物）：
#   .dep-e2e   —— 安装版依赖工具链 E2E 的证据与临时安装目录
#   .e2e-*     —— 其它同类验收脚本
.dep-e2e/
.e2e-*/
# P4 最小复现装置的工作目录（可再生产物）：
#   .repro   —— scripts/repro_sidecar_kill.py 的两份安装、证据与探测脚本
.repro/

# install-e2e 的一次性驱动脚本（证据在 .e2e-work/，脚本本身是可再生的）
.e2e-*.py
